{
  "name": "@archelia/ui-server",
  "private": true,
  "version": "1.0.0",
  "description": "Archelia OS Desktop Client",
  "author": "Archelia",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite preview --port ${PORT:-3000} --host 0.0.0.0"
  },
  "build": {
    "appId": "com.archelia.os",
    "productName": "Archelia OS",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/react-big-calendar": "^1.16.3",
    "@types/three": "^0.185.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^17.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14",
    "vite": "^8.1.1",
    "@vitejs/plugin-react": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}