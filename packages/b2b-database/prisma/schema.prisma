generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-b2b"
}

datasource db {
  provider = "postgresql"
  url      = env("B2B_DATABASE_URL")
}

model B2BUser {
  id                 String       @id @default(cuid())
  username           String       @unique
  email              String?      @unique
  passwordHash       String
  tempPassword       String?
  mustChangePassword Boolean      @default(true)
  
  firstName          String?
  lastName           String?
  companyName        String?
  vatNumber          String?
  zucchettiCode      String?      @unique

  role               B2BRole      @default(USER)
  agentId            String?
  agent              B2BUser?     @relation("AgentToClient", fields: [agentId], references: [id])
  clients            B2BUser[]    @relation("AgentToClient")
  
  zucchettiPriceList String?
  customerType       String?
  fido               Float?
  discount           Float        @default(0)
  
  address            String?
  city               String?
  zip                String?
  province           String?
  phone              String?
  
  isElmarkCustomer   Boolean      @default(false)
  elmarkDiscounts    Json?        // Sconti per categorie Elmark
  isActive           Boolean      @default(true)

  sessions           B2BSession[]
  carts              B2BCart[]
  orders             B2BOrder[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("b2b_users")
}

enum B2BRole {
  USER
  AGENT
  ADMIN
}

model B2BSession {
  id        String   @id @default(cuid())
  userId    String
  user      B2BUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("b2b_sessions")
}

model B2BCart {
  id        String        @id @default(cuid())
  userId    String?
  user      B2BUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    CartStatus    @default(ACTIVE)

  items     B2BCartItem[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("b2b_carts")
}

model B2BCartItem {
  id              String   @id @default(cuid())
  cartId          String
  cart            B2BCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  sku             String
  quantity        Int      @default(1)
  extraDiscount   Float?   @default(0)
  extraDiscountMinQty Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cartId, sku])
  @@map("b2b_cart_items")
}

enum CartStatus {
  ACTIVE
  CHECKOUT_PENDING
  COMPLETED
  ABANDONED
}

model B2BOrder {
  id                    String          @id @default(cuid())
  userId                String          // Il cliente finale
  user                  B2BUser         @relation(fields: [userId], references: [id])
  createdById           String          // Può essere il cliente stesso o l'agente
  status                OrderStatus     @default(DRAFT)
  
  zucchettiOrderRef     String?         // Riferimento o numero ordine in Zucchetti
  totalAmount           Float           @default(0)
  totalIva              Float           @default(0)
  
  notes                 String?

  items                 B2BOrderItem[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("b2b_orders")
}

model B2BOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           B2BOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sku             String
  quantity        Int       @default(1)
  originalPrice   Float
  finalPrice      Float     // Prezzo scontato finale
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("b2b_order_items")
}

enum OrderStatus {
  DRAFT
  PENDING_AGENT_REVIEW
  APPROVED
  SENT_TO_ZUCCHETTI
  ERROR
}
