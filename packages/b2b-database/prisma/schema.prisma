generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-b2b"
}

datasource db {
  provider = "postgresql"
  url      = env("B2B_DATABASE_URL")
}

model B2BUser {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  companyName    String?
  vatNumber      String?
  zucchettiCode  String?      @unique

  sessions       B2BSession[]
  carts          B2BCart[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("b2b_users")
}

model B2BSession {
  id        String   @id @default(cuid())
  userId    String
  user      B2BUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("b2b_sessions")
}

model B2BCart {
  id        String        @id @default(cuid())
  userId    String?
  user      B2BUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    CartStatus    @default(ACTIVE)

  items     B2BCartItem[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("b2b_carts")
}

model B2BCartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      B2BCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  sku       String
  quantity  Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, sku])
  @@map("b2b_cart_items")
}

enum CartStatus {
  ACTIVE
  CHECKOUT_PENDING
  COMPLETED
  ABANDONED
}
