generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-b2b"
}

datasource db {
  provider = "postgresql"
  url      = env("B2B_DATABASE_URL")
}

model B2BUser {
  id                 String       @id @default(cuid())
  username           String       @unique
  email              String?      @unique
  passwordHash       String
  tempPassword       String?
  mustChangePassword Boolean      @default(true)
  
  firstName          String?
  lastName           String?
  companyName        String?
  vatNumber          String?
  fiscalCode         String?
  formaGiuridica     String?
  pecEmail           String?
  codiceDestinatario String?
  zucchettiCode      String?      @unique
  sdrProspectId      Int?         @unique

  role               B2BRole      @default(USER)
  agentId            String?
  agent              B2BUser?     @relation("AgentToClient", fields: [agentId], references: [id])
  clients            B2BUser[]    @relation("AgentToClient")
  
  zucchettiPriceList String?
  customerType       String?
  fido               Float?
  discount           Float        @default(0)
  
  address            String?
  city               String?
  zip                String?
  province           String?
  phone              String?
  
  isElmarkCustomer   Boolean      @default(false)
  elmarkDiscounts    Json?        // Sconti per categorie Elmark
  isActive           Boolean      @default(true)

  sessions           B2BSession[]
  carts              B2BCart[]
  orders             B2BOrder[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("b2b_users")
}

enum B2BRole {
  USER
  AGENT
  ADMIN
}

enum PromoProspectStatus {
  CONTACTED
  LOGGED_IN
  ORDER_PENDING_APPROVAL
  CONVERTED
  EXPIRED
}

model B2BPromoProspect {
  id                   String              @id @default(cuid())
  sdrProspectId        Int                 @unique
  
  username             String              @unique
  email                String              @unique
  passwordHash         String
  tempPassword         String?
  mustChangePassword   Boolean             @default(true)
  passwordChangedAt    DateTime?
  
  companyName          String
  formaGiuridica       String?
  vatNumber            String?
  fiscalCode           String?
  firstName            String?
  lastName             String?
  sesso                String?
  pecEmail             String?
  codiceDestinatario   String?
  
  categoryCluster      String
  commercialCategory   String              @default("IST") // "IST" (40%) o "RIV" (50%)
  discount             Float               @default(40)
  
  address              String?
  streetNumber         String?
  city                 String?
  zip                  String?
  province             String?
  region               String?
  phone                String?
  whatsappPhone        String?
  website              String?
  shippingAddressJson  Json?
  
  agentId              String              @default("cmtu64h1c0000jk0sb1ho1o49") // Daniele Savoia
  agentCode            String              @default("003")                      // Daniele Savoia
  
  firstPurchaseRuleId  String?
  orderDetailsSnapshot Json?
  attachedCatalogMeta  Json?
  
  status               PromoProspectStatus @default(CONTACTED)
  emailSentAt          DateTime            @default(now())
  firstLoginAt         DateTime?
  lastLoginAt          DateTime?
  loginCount           Int                 @default(0)
  
  convertedToUserId    String?             @unique
  convertedAt          DateTime?
  firstOrderId         String?
  
  isActive             Boolean             @default(true)
  expiresAt            DateTime?

  sessions             B2BSession[]
  carts                B2BCart[]
  orders               B2BOrder[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([agentId, status])
  @@index([agentCode, status])
  @@index([status, lastLoginAt])
  @@index([commercialCategory])
  @@map("b2b_promo_prospects")
}

model B2BDiscountRule {
  id                  String    @id
  agentId             String
  agentCode           String    @default("")
  name                String    @default("")
  clientScope         String    @default("ALL_CLIENTS")
  clientId            String?
  clientCode          String?
  clientName          String?
  clientIds           Json      @default("[]")
  clientCodes         Json      @default("[]")
  clientsMeta         Json      @default("[]")
  clientCategories    Json      @default("[]")
  targetType          String    @default("PRODUCTS")
  targetSkus          Json      @default("[]")
  targetProductsMeta  Json      @default("[]")
  targetBrands        Json      @default("[]")
  targetProductGroups Json      @default("[]")
  targetFamilies      Json      @default("[]")
  targetCategories    Json      @default("[]")
  calculationMode     String    @default("EXTRA_CASCADE")
  discountValue       Float     @default(0)
  isActive            Boolean   @default(true)
  expiryType          String    @default("NONE")
  expiresAt           DateTime?
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([agentId, isActive], map: "idx_b2b_agent_discount_rules_agent")
  @@map("b2b_agent_discount_rules")
}

model B2BSession {
  id              String            @id @default(cuid())
  userId          String?
  user            B2BUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoProspectId String?
  promoProspect   B2BPromoProspect? @relation(fields: [promoProspectId], references: [id], onDelete: Cascade)
  token           String            @unique
  expiresAt       DateTime

  createdAt       DateTime          @default(now())

  @@map("b2b_sessions")
}

model B2BCart {
  id              String            @id @default(cuid())
  userId          String?
  user            B2BUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoProspectId String?
  promoProspect   B2BPromoProspect? @relation(fields: [promoProspectId], references: [id], onDelete: SetNull)
  status          CartStatus        @default(ACTIVE)
  linkedOrderId   String?
  cartType        String            @default("ZUCCHETTI")

  items           B2BCartItem[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("b2b_carts")
}

model B2BCartItem {
  id                  String   @id @default(cuid())
  cartId              String
  cart                B2BCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  sku                 String
  quantity            Int      @default(1)
  extraDiscount       Float?   @default(0)
  extraDiscountMinQty Int?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([cartId, sku])
  @@map("b2b_cart_items")
}

enum CartStatus {
  ACTIVE
  REVIEW
  CHECKOUT_PENDING
  COMPLETED
  ABANDONED
}

model B2BOrder {
  id                String            @id @default(cuid())
  userId            String?           // Il cliente finale (valorizzato per clienti attivi o dopo approvazione 1° ordine)
  user              B2BUser?          @relation(fields: [userId], references: [id])
  promoProspectId   String?           // Valorizzato per il 1° ordine di un prospect in attesa di approvazione
  promoProspect     B2BPromoProspect? @relation(fields: [promoProspectId], references: [id])
  createdById       String            // Può essere il cliente stesso, il prospect o l'agente
  status            OrderStatus       @default(DRAFT)
  storeMode         String            @default("ZUCCHETTI")
  
  zucchettiOrderRef String?           // Riferimento o numero ordine in Zucchetti
  totalAmount       Float             @default(0)
  totalIva          Float             @default(0)
  
  notes             String?

  items             B2BOrderItem[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("b2b_orders")
}

model B2BOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           B2BOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sku             String
  quantity        Int       @default(1)
  originalPrice   Float
  finalPrice      Float     // Prezzo scontato finale
  discountString  String?   // Es: "40+10" oppure "50+5"
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("b2b_order_items")
}

enum OrderStatus {
  DRAFT
  PENDING_AGENT_REVIEW
  APPROVED
  SENT_TO_ZUCCHETTI
  ERROR
}
