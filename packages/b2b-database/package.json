{
  "name": "@archelia/b2b-database",
  "version": "1.0.0",
  "description": "B2B Database definitions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "B2B_DATABASE_URL=${B2B_DATABASE_URL:-postgresql://neondb_owner:npg@localhost:5432/neondb} sh -c './node_modules/.bin/prisma generate || npx prisma generate'",
    "db:push": "npx dotenv -e ../../.env -- npx prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.14.0",
    "typescript": "^5.0.0"
  }
}
