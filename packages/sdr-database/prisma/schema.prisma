generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-sdr"
}

datasource db {
  provider = "postgresql"
  url      = env("SDR_DATABASE_URL")
}

model SdrProspect {
  id                  Int               @id @default(autoincrement())
  companyName         String            @map("company_name")
  vatNumber           String?           @map("vat_number")
  fiscalCode          String?           @map("fiscal_code")
  atecoCode           String?           @map("ateco_code")
  categoryCluster     String            @map("category_cluster")
  commercialCategory  String            @default("IST") @map("commercial_category") // "IST" (40%) o "RIV" (50%)
  baseDiscount        Float             @default(40) @map("base_discount")
  
  address             String?
  city                String
  province            String
  region              String
  cap                 String?
  
  phone               String?
  whatsappPhone       String?           @map("whatsapp_phone")
  website             String?
  
  ordinaryEmail       String?           @map("ordinary_email")
  isPecVerified       Boolean           @default(false) @map("is_pec_verified")
  pecRejectedLog      String?           @map("pec_rejected_log")
  pecCamerale         String?           @map("pec_camerale")
  
  section             String            @default("Senza_Email") // Email_Pronta, Senza_Email, PEC_Scartata
  leadScore           Int               @default(0) @map("lead_score")
  confidenceScore     Float             @default(1.0) @map("confidence_score")
  auditPassed         Boolean           @default(true) @map("audit_passed")
  auditNotes          String?           @map("audit_notes")
  sourceEngine        String?           @map("source_engine")
  sourceUrl           String?           @map("source_url")
  
  aiProfileSummary    String?           @map("ai_profile_summary")
  brandsDetected      String?           @map("brands_detected")
  recommendedFamily   String?           @map("recommended_family")
  richMetadata        Json?             @default("{}") @map("rich_metadata")
  
  pipelineStatus      String            @default("Da_Contattare") @map("pipeline_status")
  promoProspectId     String?           @unique @map("promo_prospect_id") // ID in b2b_promo_prospects quando contattato
  promotedB2bUserId   String?           @unique @map("promoted_b2b_user_id") // ID in b2b_users dopo approvazione 1° ordine
  promotedUsername    String?           @map("promoted_username")
  promotedAt          DateTime?         @map("promoted_at")
  assignedAgentId     String?           @default("cmtu64h1c0000jk0sb1ho1o49") @map("assigned_agent_id")
  assignedAgentCode   String?           @default("003") @map("assigned_agent_code")
  
  sentinelAttempts    Int               @default(0) @map("sentinel_attempts")
  lastSentinelCheckAt DateTime?         @map("last_sentinel_check_at")

  drafts              SdrOutreachDraft[]
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([companyName, city])
  @@index([section])
  @@index([categoryCluster])
  @@index([commercialCategory])
  @@index([region, province, city])
  @@index([pipelineStatus])
  @@index([section, lastSentinelCheckAt])
  @@map("sdr_prospects")
}

model SdrOutreachDraft {
  id                  Int         @id @default(autoincrement())
  prospectId          Int         @map("prospect_id")
  prospect            SdrProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequenceStep        Int         @default(1) @map("sequence_step")
  subject             String
  bodyText            String      @map("body_text")
  bodyHtml            String?     @map("body_html")
  attachedCatalogUrl  String?     @map("attached_catalog_url")
  status              String      @default("Bozza_Pronta")
  senderInboxId       Int?        @map("sender_inbox_id")
  scheduledFor        DateTime?   @map("scheduled_for")
  sentAt              DateTime?   @map("sent_at")
  replyReceivedAt     DateTime?   @map("reply_received_at")
  replySnippet        String?     @map("reply_snippet")

  // Estensioni V2: Smart Tracking Catalistino PDF, Multi-Agente e Correlazione IMAP
  trackingToken       String?     @unique @map("tracking_token")
  catalogOpenedAt     DateTime?   @map("catalog_opened_at")
  catalogOpenCount    Int         @default(0) @map("catalog_open_count")
  assignedAgentId     String?     @map("assigned_agent_id")
  assignedAgentCode   String?     @map("assigned_agent_code")
  assignedAgentName   String?     @map("assigned_agent_name")
  templateCode        String?     @map("template_code")
  messageIdHeader     String?     @map("message_id_header")
  lastError           String?     @map("last_error")

  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([prospectId, sequenceStep])
  @@index([status, scheduledFor])
  @@index([messageIdHeader])
  @@index([catalogOpenCount])
  @@map("sdr_outreach_drafts")
}

model SdrOutreachConfig {
  id                        String   @id @default("default")
  name                      String   @default("Configurazione Offerta B2B Izzo Distribuzione")
  
  // 1. Parametri Sconto 1° Acquisto Autogenerato (FIRST_PURCHASE — Solo 2gg)
  enableFirstPurchaseRule   Boolean  @default(true) @map("enable_first_purchase_rule")
  istExtraDiscountPct       Float    @default(10) @map("ist_extra_discount_pct")
  rivExtraDiscountPct       Float    @default(10) @map("riv_extra_discount_pct")
  discountCalculationMode   String   @default("EXTRA_CASCADE") @map("discount_calculation_mode")
  discountTargetType        String   @default("ALL_2GG") @map("discount_target_type")
  discountTargetFiltersJson Json     @default("{}") @map("discount_target_filters_json")
  
  // 2. Dettagli e Condizioni del 1° Ordine (Stampati in Mail + Pagina 2 Catalogo PDF)
  offerTitle                String   @default("Offerta Riservata Nuovi Partner B2B — Extra Sconto sul 1° Acquisto") @map("offer_title")
  minOrderAmountText        String   @default("Nessun minimo d'ordine sul tuo 1° acquisto") @map("min_order_amount_text")
  freeShippingText          String   @default("Spedizione rapida 24/48h in tutta Italia da Deposito Principale") @map("free_shipping_text")
  paymentTermsText          String   @default("Condizioni B2B riservate con referente dedicato Daniele Savoia") @map("payment_terms_text")
  customCommercialNotes     String?  @map("custom_commercial_notes")
  defaultAgentId            String   @default("cmtu64h1c0000jk0sb1ho1o49") @map("default_agent_id")
  defaultAgentCode          String   @default("003") @map("default_agent_code")
  defaultAgentName          String   @default("Daniele Savoia") @map("default_agent_name")
  
  // 3. Parametri Catalogo PDF Autogenerato e Link Smart Tracciato
  attachCatalogPdf          Boolean  @default(true) @map("attach_catalog_pdf")
  enableSmartCatalogLink    Boolean  @default(true) @map("enable_smart_catalog_link")
  attachPhysicalPdf         Boolean  @default(false) @map("attach_physical_pdf")
  catalogSelectionMode      String   @default("BY_CLUSTER") @map("catalog_selection_mode") // GLOBAL | BY_CLUSTER
  globalCatalogFiltersJson  Json     @default("{}") @map("global_catalog_filters_json")
  clusterCatalogPresetsJson Json     @default("{}") @map("cluster_catalog_presets_json")
  catalogPriceMode          String   @default("LIST_AND_NET") @map("catalog_price_mode")
  catalogStockMode          String   @default("BADGE_ONLY") @map("catalog_stock_mode")
  catalogWarehouse          String   @default("MAIN_2GG") @map("catalog_warehouse")
  catalogIncludeZeroStock   Boolean  @default(false) @map("catalog_include_zero_stock")
  catalogSortBy             String   @default("STOCK_DESC") @map("catalog_sort_by")
  catalogMaxProducts        Int      @default(60) @map("catalog_max_products")
  
  // 4. Parametri Time-Fencing, Jitter & Marcia Velocità SMTP
  timeFencingEnabled        Boolean  @default(true) @map("time_fencing_enabled")
  morningWindow             String   @default("08:30-12:30") @map("morning_window")
  afternoonWindow           String   @default("14:00-17:30") @map("afternoon_window")
  jitterMinSeconds          Int      @default(180) @map("jitter_min_seconds")
  jitterMaxSeconds          Int      @default(420) @map("jitter_max_seconds")
  speedProfile              String   @default("PRUDENT_WARMUP") @map("speed_profile") // PRUDENT_WARMUP | STANDARD | FULL_REGIME
  sentinelEnabled           Boolean  @default(true) @map("sentinel_enabled")

  updatedAt                 DateTime @updatedAt @map("updated_at")
  @@map("sdr_outreach_configs")
}

model SdrInboxAccount {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  domainName          String?   @map("domain_name")
  displayName         String    @map("display_name")
  smtpHost            String    @map("smtp_host")
  smtpPort            Int       @default(465) @map("smtp_port")
  smtpUser            String    @map("smtp_user")
  smtpPasswordEnc     String    @map("smtp_password_enc")
  imapHost            String    @map("imap_host")
  imapPort            Int       @default(993) @map("imap_port")
  imapUser            String?   @map("imap_user")
  imapPasswordEnc     String?   @map("imap_password_enc")
  useTls              Boolean   @default(true) @map("use_tls")
  warmupEnabled       Boolean   @default(true) @map("warmup_enabled")
  warmupStartedAt     DateTime  @default(now()) @map("warmup_started_at")
  dailyLimit          Int       @default(5) @map("daily_limit")
  targetDailyLimit    Int       @default(15) @map("target_daily_limit")
  sentToday           Int       @default(0) @map("sent_today")
  isActive            Boolean   @default(true) @map("is_active")
  lastSentAt          DateTime? @map("last_sent_at")
  lastImapSyncAt      DateTime? @map("last_imap_sync_at")
  lastImapUid         Int       @default(0) @map("last_imap_uid")
  lastTestAt          DateTime? @map("last_test_at")
  lastTestStatus      String?   @map("last_test_status")
  lastTestError       String?   @map("last_test_error")
  consecutiveErrors   Int       @default(0) @map("consecutive_errors")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([domainName, isActive])
  @@map("sdr_inbox_accounts")
}

model SdrExploredMunicipality {
  id                  Int      @id @default(autoincrement())
  comuneCode          String   @map("comune_code")
  comuneName          String   @map("comune_name")
  province            String
  region              String
  cap                 String?
  categoryCluster     String   @map("category_cluster")
  leadsFoundCount     Int      @default(0) @map("leads_found_count")
  emailsFoundCount    Int      @default(0) @map("emails_found_count")
  sourcesUsed         String?  @map("sources_used")
  lastScannedAt       DateTime @default(now()) @map("last_scanned_at")

  @@unique([comuneCode, categoryCluster])
  @@index([region, province])
  @@index([categoryCluster, lastScannedAt])
  @@map("sdr_explored_municipalities")
}

model SdrInboxEvent {
  id                  Int      @id @default(autoincrement())
  inboxAccountId      Int?     @map("inbox_account_id")
  prospectId          Int?     @map("prospect_id")
  draftId             Int?     @map("draft_id")
  fromEmail           String   @map("from_email")
  toEmail             String?  @map("to_email")
  subject             String?
  snippet             String?
  eventType           String   @map("event_type") // REPLY | BOUNCE | OPT_OUT | OUT_OF_OFFICE | SIMULATED
  sentiment           String?
  killSwitchTriggered Boolean  @default(true) @map("kill_switch_triggered")
  agentAlertSent      Boolean  @default(false) @map("agent_alert_sent")
  messageUid          Int?     @map("message_uid")
  messageId           String?  @unique @map("message_id")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([prospectId])
  @@index([eventType, createdAt])
  @@map("sdr_inbox_events")
}

model SdrEngineState {
  id                          String    @id @default("default")
  searchRunning               Boolean   @default(false) @map("search_running")
  searchCurrentRegion         String?   @map("search_current_region")
  searchCurrentProvince       String?   @map("search_current_province")
  searchCurrentMunicipality   String?   @map("search_current_municipality")
  searchCurrentCategory       String?   @map("search_current_category")
  searchProgressPct           Float     @default(0) @map("search_progress_pct")
  searchTotalScanned          Int       @default(0) @map("search_total_scanned")
  searchFoundNew              Int       @default(0) @map("search_found_new")
  searchStartedAt             DateTime? @map("search_started_at")
  searchLastHeartbeatAt       DateTime? @map("search_last_heartbeat_at")

  autopilotEnabled            Boolean   @default(false) @map("autopilot_enabled")
  autopilotCyclesCompleted    Int       @default(0) @map("autopilot_cycles_completed")
  sentinelEnabled             Boolean   @default(true) @map("sentinel_enabled")
  sentinelRunning             Boolean   @default(false) @map("sentinel_running")

  mapsStrategy                String    @default("FREE_TIER_ONLY") @map("maps_strategy")
  mapsDailyLimitCalls         Int       @default(150) @map("maps_daily_limit_calls")
  mapsDailyBudgetEur          Float     @default(0) @map("maps_daily_budget_eur")
  mapsCallsToday              Int       @default(0) @map("maps_calls_today")
  mapsSpentTodayEur           Float     @default(0) @map("maps_spent_today_eur")
  mapsLastResetDate           String?   @map("maps_last_reset_date")

  updatedAt                   DateTime  @updatedAt @map("updated_at")
  @@map("sdr_engine_states")
}

model SdrSentinelRun {
  id                  Int      @id @default(autoincrement())
  cycleNumber         Int      @map("cycle_number")
  processedCount      Int      @default(0) @map("processed_count")
  upgradedEmailCount  Int      @default(0) @map("upgraded_email_count")
  pecFilteredCount    Int      @default(0) @map("pec_filtered_count")
  websitesFoundCount  Int      @default(0) @map("websites_found_count")
  durationMs          Int      @default(0) @map("duration_ms")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("sdr_sentinel_runs")
}

model SdrBlacklist {
  id                  Int      @id @default(autoincrement())
  emailOrDomain       String   @unique @map("email_or_domain")
  reason              String
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("sdr_blacklist")
}

model SdrEmailTemplate {
  id                  Int      @id @default(autoincrement())
  code                String   @unique
  name                String
  angleGroup          String   @map("angle_group")
  targetCategory      String   @default("ALL") @map("target_category")
  htmlLayoutVariant   String   @default("executive_card") @map("html_layout_variant")
  subjectTemplate     String   @map("subject_template")
  bodyTemplate        String   @map("body_template")
  isActive            Boolean  @default(true) @map("is_active")
  usageCount          Int      @default(0) @map("usage_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([isActive, targetCategory])
  @@index([angleGroup])
  @@map("sdr_email_templates")
}

model SdrSynonymToken {
  id                  Int      @id @default(autoincrement())
  tokenKey            String   @unique @map("token_key")
  category            String
  description         String
  variants            String[]
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([isActive, category])
  @@map("sdr_synonym_tokens")
}
